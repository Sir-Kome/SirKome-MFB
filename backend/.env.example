DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/mfb_database

# Development SMTP example using MailHog
SIRKOME_SMTP_HOST=localhost
SIRKOME_SMTP_PORT=1025
SIRKOME_SMTP_USER=no-reply@example.test
SIRKOME_SMTP_PASS=ignored
SIRKOME_FROM=no-reply@example.test

# Production: replace with your provider's settings
# SIRKOME_SMTP_HOST=smtp.sendgrid.net
# SIRKOME_SMTP_PORT=587
# SIRKOME_SMTP_USER=apikey
# SIRKOME_SMTP_PASS=YOUR_SENDGRID_API_KEY
# SIRKOME_FROM=no-reply@yourdomain.com
